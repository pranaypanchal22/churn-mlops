# Copy to .env and adjust. Contains no secrets; this project needs none.

# Host ports for docker compose
API_PORT=8000
FRONTEND_PORT=8501

# API (also read by `uvicorn churn.api.app:app` when run outside Docker)
# Leave CHURN_MODEL_VERSION empty to serve the promoted version (models/registry/current.json).
CHURN_MODEL_VERSION=
CHURN_MAX_BATCH_SIZE=100
CHURN_LOG_LEVEL=INFO
# Outside Docker only (the image sets these to /app/...):
# CHURN_REGISTRY_DIR=models/registry
# CHURN_SCHEMA_PATH=configs/schema.yaml

# Frontend
CHURN_API_TIMEOUT=5
# Outside Docker only (compose sets http://api:8000):
# CHURN_API_URL=http://localhost:8000

# Trainer container file ownership on Linux/macOS hosts: set to `id -u` / `id -g`.
HOST_UID=10001
HOST_GID=10001
